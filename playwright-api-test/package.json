{
  "name": "playwright-api-test",
  "version": "0.1.0",
  "description": "API test cases using Playwright with TypeScript - ported from Karate",
  "private": true,
  "scripts": {
    "test": "npx playwright test",
    "test:positive": "npx playwright test --grep @positive",
    "test:negative": "npx playwright test --grep @negative",
    "test:add-to-cart": "npx playwright test add-to-cart",
    "test:remove-from-cart": "npx playwright test remove-from-cart",
    "test:update-product": "npx playwright test update-product-in-cart",
    "test:checkout": "npx playwright test process-checkout",
    "lint": "eslint . --ext .ts"
  },
  "keywords": [
    "API",
    "Playwright",
    "TypeScript"
  ],
  "author": "Ian Renauld",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "^2.29.0",
    "joi": "^17.12.0",
    "typescript": "^5.3.0"
  }
}
